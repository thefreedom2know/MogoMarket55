# Copy this file to local.properties (it is ignored by git) and fill in your own values.
# local.properties only holds the release-signing values. Never commit it.

# API keys (Finnhub, Groq, Gemini) and the email password do NOT go here any more: anything
# compiled into the APK can be extracted. They are Firebase Functions secrets - see
# functions/README.md.

# Release signing (optional)
STORE_FILE=
STORE_PASSWORD=
KEY_ALIAS=release
KEY_PASSWORD=
