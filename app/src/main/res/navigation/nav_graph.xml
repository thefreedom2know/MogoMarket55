        android:name="com.mogomarket.app.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/portfolioAddStockFragment"
        android:name="com.mogomarket.app.PortfolioAddStockFragment"
