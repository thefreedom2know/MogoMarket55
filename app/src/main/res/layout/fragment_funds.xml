<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pf_07080b"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="קופות גמל ופנסיה"
                android:textColor="@color/pf_ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFundsRefresh"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="רענן נתונים"
                android:textColor="@color/pf_8fdff0"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/pf_0c1018"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#6634D399"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="שווי החיסכון לטווח ארוך"
                    android:textColor="@color/pf_34d399"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFundsTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₪0"
                    android:textColor="@color/pf_ffffff"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFundsAsOf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pf_8d9aae"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/pf_1e2a3a" />

                <TextView
                    android:id="@+id/tvStocksIls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pf_e6ddf4"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCombinedTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/pf_ffb84d"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeightedExposure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/pf_8d9aae"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeeAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/pf_21171a"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pf_ff7279"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvFeeAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/pf_fff1e8"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/allocationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="חלוקה לפי מסלול השקעה"
                android:textColor="@color/pf_ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.mogomarket.app.FundAllocationBarView
                android:id="@+id/fundAllocationBar"
                android:layout_width="match_parent"
                android:layout_height="18dp" />

            <LinearLayout
                android:id="@+id/allocationLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportHarHakesef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="ייבוא מהר הכסף"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFund"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="הוספה ידנית"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFundsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:lineSpacingExtra="3dp"
            android:text="עוד אין כאן קופות.\n\nהדרך הקלה: היכנסו לאתר הר הכסף של משרד האוצר, הזדהו, הורידו את הרשימה לאקסל ובחרו כאן &quot;ייבוא מהר הכסף&quot;.\n\nאפשר גם להוסיף קופה לפי מספר הקופה (מופיע בדוח השנתי מהקופה)."
            android:textColor="@color/pf_8d9aae"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/fundsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="תשואות ודמי ניהול: נתוני גמל-נט, פנסיה-נט וביטוח-נט של רשות שוק ההון (data.gov.il), מתעדכנים פעם בחודש. התשואות הן ברוטו (לפני דמי ניהול). השווי הנוכחי הוא הערכה: היתרה שהזנתם, בתוספת התשואות החודשיות שפורסמו מאז, פחות דמי הניהול ובתוספת ההפקדה החודשית. מדד S&amp;P 500 במונחי דולר. אין לראות בזה ייעוץ השקעות."
            android:textColor="@color/pf_657184"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
